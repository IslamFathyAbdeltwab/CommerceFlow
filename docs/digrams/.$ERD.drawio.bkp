        <mxCell id="rD2CrnjHf7nBMmlK65hn-104" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="value object" vertex="1">
          <mxGeometry height="30" width="120" x="1880" y="1680" as="geometry" />
        </mxCell>
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%% CommerceFlow - full ERD (Domain model)\n%% Open in draw.io: Arrange &gt; Insert &gt; Advanced &gt; Mermaid, then paste this file.\n%% Or preview at https://mermaid.live\nerDiagram\n\n    %% ---------- Identity (Infrastructure, referenced by Guid only) ----------\n    ApplicationUser {\n        Guid Id PK\n        string Email\n        string FirstName\n        string LastName\n        bool IsActive\n    }\n\n    %% ---------- Catalog ----------\n    Brand {\n        Guid Id PK\n        string Name\n        string Slug UK\n        bool IsActive\n    }\n    Category {\n        Guid Id PK\n        Guid ParentCategoryId FK \&quot;optional\&quot;\n        string Name\n        string Slug UK\n        int DisplayOrder\n        bool IsActive\n    }\n    Product {\n        Guid Id PK\n        Guid BrandId FK \&quot;optional\&quot;\n        string Name\n        string Slug UK\n        ProductStatus Status\n        bool IsFeatured\n        DateTimeOffset PublishedAtUtc\n    }\n    ProductVariant {\n        Guid Id PK\n        Guid ProductId FK\n        string Name\n        string Sku UK\n        decimal Price\n        decimal CompareAtPrice\n        bool IsActive\n    }\n    ProductImage {\n        Guid Id PK\n        Guid ProductId FK\n        Guid ProductVariantId FK \&quot;optional\&quot;\n        string StorageKey\n        string AltText\n        int DisplayOrder\n        bool IsPrimary\n    }\n    ProductCategory {\n        Guid ProductId PK, FK\n        Guid CategoryId PK, FK\n        DateTimeOffset AssignedAtUtc\n    }\n    ProductAttribute {\n        Guid Id PK\n        string Name\n        string Code UK\n        AttributeDataType DataType\n        bool IsVariantDefining\n        bool IsFilterable\n    }\n    ProductVariantAttributeValue {\n        Guid ProductVariantId PK, FK\n        Guid ProductAttributeId PK, FK\n        string Value\n    }\n\n    %% ---------- Customers ----------\n    CustomerAddress {\n        Guid Id PK\n        Guid UserId FK\n        string Label\n        string RecipientName\n        string CountryCode\n        string City\n        string AddressLine1\n        bool IsDefault\n    }\n    Cart {\n        Guid Id PK\n        Guid UserId FK\n        CartStatus Status\n        DateTimeOffset ExpiresAtUtc\n    }\n    CartItem {\n        Guid Id PK\n        Guid CartId FK\n        Guid ProductVariantId FK\n        int Quantity\n    }\n    Wishlist {\n        Guid Id PK\n        Guid UserId FK\n        string Name\n        bool IsDefault\n    }\n    WishlistItem {\n        Guid Id PK\n        Guid WishlistId FK\n        Guid ProductId FK\n        DateTimeOffset AddedAtUtc\n    }\n\n    %% ---------- Inventory ----------\n    Warehouse {\n        Guid Id PK\n        string Code UK\n        string Name\n        bool IsActive\n    }\n    InventoryItem {\n        Guid Id PK\n        Guid WarehouseId FK\n        Guid ProductVariantId FK\n        int OnHandQuantity\n        int ReservedQuantity\n        int ReorderThreshold\n        bytes RowVersion\n    }\n    InventoryReservation {\n        Guid Id PK\n        Guid OrderId FK\n        ReservationStatus Status\n        DateTimeOffset ExpiresAtUtc\n        DateTimeOffset ReleasedAtUtc\n    }\n    InventoryReservationItem {\n        Guid Id PK\n        Guid InventoryReservationId FK\n        Guid WarehouseId \&quot;with ProductVariantId = InventoryItem\&quot;\n        Guid ProductVariantId \&quot;with WarehouseId = InventoryItem\&quot;\n        int Quantity\n    }\n    StockMovement {\n        Guid Id PK\n        Guid WarehouseId FK\n        Guid ProductVariantId FK\n        StockMovementType MovementType\n        int QuantityChange\n        int QuantityAfter\n        string ReferenceType\n        Guid ReferenceId\n        Guid PerformedByUserId FK \&quot;optional\&quot;\n        DateTimeOffset CreatedAtUtc\n    }\n\n    %% ---------- Orders ----------\n    Order {\n        Guid Id PK\n        string OrderNumber UK\n        Guid CustomerId FK\n        OrderStatus Status\n        string CurrencyCode\n        decimal Subtotal\n        decimal DiscountTotal\n        decimal TaxTotal\n        decimal ShippingTotal\n        decimal GrandTotal\n        Guid PromotionId FK \&quot;optional\&quot;\n        AddressSnapshot ShippingAddress \&quot;owned value object\&quot;\n        AddressSnapshot BillingAddress \&quot;owned value object\&quot;\n        DateTimeOffset PlacedAtUtc\n    }\n    OrderItem {\n        Guid Id PK\n        Guid OrderId FK\n        Guid ProductVariantId FK\n        string ProductNameSnapshot\n        string VariantNameSnapshot\n        string SkuSnapshot\n        decimal UnitPrice\n        int Quantity\n        decimal LineTotal\n    }\n    OrderStatusHistory {\n        Guid Id PK\n        Guid OrderId FK\n        OrderStatus PreviousStatus\n        OrderStatus NewStatus\n        Guid ChangedByUserId FK \&quot;optional\&quot;\n        string Reason\n        DateTimeOffset ChangedAtUtc\n    }\n\n    %% ---------- Promotions ----------\n    Promotion {\n        Guid Id PK\n        string Code UK\n        DiscountType DiscountType\n        decimal DiscountValue\n        decimal MinimumOrderSubtotal\n        DateTimeOffset StartsAtUtc\n        DateTimeOffset EndsAtUtc\n        int MaximumRedemptions\n        bool IsActive\n    }\n    PromotionProduct {\n        Guid PromotionId PK, FK\n        Guid ProductId PK, FK\n    }\n    PromotionRedemption {\n        Guid Id PK\n        Guid PromotionId FK\n        Guid UserId FK\n        Guid OrderId FK\n        decimal DiscountAmount\n        DateTimeOffset RedeemedAtUtc\n    }\n\n    %% ---------- Payments ----------\n    Payment {\n        Guid Id PK\n        Guid OrderId FK\n        string Provider\n        string ProviderPaymentId\n        decimal Amount\n        PaymentStatus Status\n        DateTimeOffset PaidAtUtc\n    }\n    PaymentAttempt {\n        Guid Id PK\n        Guid PaymentId FK\n        int AttemptNumber\n        string IdempotencyKey UK\n        PaymentAttemptStatus Status\n        string FailureCode\n    }\n    Refund {\n        Guid Id PK\n        Guid PaymentId FK\n        Guid ReturnRequestId FK \&quot;optional\&quot;\n        decimal Amount\n        RefundStatus Status\n        string ProviderRefundId\n    }\n\n    %% ---------- Shipping ----------\n    ShippingMethod {\n        Guid Id PK\n        string Name\n        decimal BasePrice\n        int EstimatedMinimumDays\n        int EstimatedMaximumDays\n        bool IsActive\n    }\n    Shipment {\n        Guid Id PK\n        Guid OrderId FK\n        Guid ShippingMethodId FK\n        string Carrier\n        string TrackingNumber\n        ShipmentStatus Status\n        decimal ShippingCost\n        AddressSnapshot ShippingAddress \&quot;owned value object\&quot;\n    }\n    ShipmentItem {\n        Guid Id PK\n        Guid ShipmentId FK\n        Guid OrderItemId FK\n        int Quantity\n    }\n    ShipmentTrackingEvent {\n        Guid Id PK\n        Guid ShipmentId FK\n        ShipmentStatus Status\n        string Description\n        DateTimeOffset OccurredAtUtc\n    }\n\n    %% ---------- Returns and Reviews ----------\n    ReturnRequest {\n        Guid Id PK\n        string ReturnNumber UK\n        Guid OrderId FK\n        Guid CustomerId FK\n        ReturnRequestStatus Status\n        string Reason\n        Guid ReviewedByUserId FK \&quot;optional\&quot;\n    }\n    ReturnItem {\n        Guid Id PK\n        Guid ReturnRequestId FK\n        Guid OrderItemId FK\n        int Quantity\n        string ItemCondition\n    }\n    ProductReview {\n        Guid Id PK\n        Guid ProductId FK\n        Guid UserId FK\n        Guid OrderItemId FK \&quot;optional, verified purchase\&quot;\n        int Rating\n        ReviewStatus Status\n        Guid ModeratedByUserId FK \&quot;optional\&quot;\n    }\n\n    %% ---------- Notifications ----------\n    Notification {\n        Guid Id PK\n        Guid RecipientUserId FK\n        NotificationType Type\n        string Title\n        bool IsRead\n        DateTimeOffset CreatedAtUtc\n    }\n    NotificationPreference {\n        Guid UserId PK, FK\n        NotificationType NotificationType PK\n        NotificationChannel Channel PK\n        bool IsEnabled\n    }\n    NotificationDeliveryAttempt {\n        Guid Id PK\n        Guid NotificationId FK\n        NotificationChannel Channel\n        NotificationDeliveryStatus Status\n        int AttemptCount\n        DateTimeOffset NextAttemptAtUtc\n    }\n\n    %% ================= RELATIONSHIPS =================\n\n    %% Catalog\n    Brand ||--o{ Product : \&quot;has\&quot;\n    Category ||--o{ Category : \&quot;parent of\&quot;\n    Product ||--o{ ProductCategory : \&quot;listed in\&quot;\n    Category ||--o{ ProductCategory : \&quot;contains\&quot;\n    Product ||--o{ ProductVariant : \&quot;has\&quot;\n    Product ||--o{ ProductImage : \&quot;has\&quot;\n    ProductVariant |o--o{ ProductImage : \&quot;tagged for\&quot;\n    ProductVariant ||--o{ ProductVariantAttributeValue : \&quot;described by\&quot;\n    ProductAttribute ||--o{ ProductVariantAttributeValue : \&quot;defines\&quot;\n\n    %% Customers\n    ApplicationUser ||--o{ CustomerAddress : \&quot;saves\&quot;\n    ApplicationUser ||--o{ Cart : \&quot;owns\&quot;\n    Cart ||--o{ CartItem : \&quot;contains\&quot;\n    ProductVariant ||--o{ CartItem : \&quot;added as\&quot;\n    ApplicationUser ||--o{ Wishlist : \&quot;owns\&quot;\n    Wishlist ||--o{ WishlistItem : \&quot;contains\&quot;\n    Product ||--o{ WishlistItem : \&quot;saved as\&quot;\n\n    %% Inventory\n    Warehouse ||--o{ InventoryItem : \&quot;stores\&quot;\n    ProductVariant ||--o{ InventoryItem : \&quot;stocked as\&quot;\n    Order ||--o{ InventoryReservation : \&quot;reserves stock\&quot;\n    InventoryReservation ||--|{ InventoryReservationItem : \&quot;holds\&quot;\n    InventoryItem ||--o{ InventoryReservationItem : \&quot;reserved from\&quot;\n    Warehouse ||--o{ StockMovement : \&quot;records\&quot;\n    ProductVariant ||--o{ StockMovement : \&quot;changes\&quot;\n    ApplicationUser |o--o{ StockMovement : \&quot;performs\&quot;\n\n    %% Orders\n    ApplicationUser ||--o{ Order : \&quot;places\&quot;\n    Order ||--|{ OrderItem : \&quot;contains\&quot;\n    ProductVariant ||--o{ OrderItem : \&quot;snapshot of\&quot;\n    Order ||--o{ OrderStatusHistory : \&quot;tracks\&quot;\n\n    %% Promotions\n    Promotion |o--o{ Order : \&quot;applied to\&quot;\n    Promotion ||--o{ PromotionProduct : \&quot;limited to\&quot;\n    Product ||--o{ PromotionProduct : \&quot;eligible for\&quot;\n    Promotion ||--o{ PromotionRedemption : \&quot;redeemed in\&quot;\n    ApplicationUser ||--o{ PromotionRedemption : \&quot;redeems\&quot;\n    Order ||--o| PromotionRedemption : \&quot;uses\&quot;\n\n    %% Payments\n    Order ||--o{ Payment : \&quot;paid by\&quot;\n    Payment ||--|{ PaymentAttempt : \&quot;tried via\&quot;\n    Payment ||--o{ Refund : \&quot;refunded by\&quot;\n    ReturnRequest |o--o{ Refund : \&quot;triggers\&quot;\n\n    %% Shipping\n    Order ||--o{ Shipment : \&quot;fulfilled by\&quot;\n    ShippingMethod ||--o{ Shipment : \&quot;used by\&quot;\n    Shipment ||--|{ ShipmentItem : \&quot;contains\&quot;\n    OrderItem ||--o{ ShipmentItem : \&quot;shipped as\&quot;\n    Shipment ||--o{ ShipmentTrackingEvent : \&quot;tracked by\&quot;\n\n    %% Returns and Reviews\n    Order ||--o{ ReturnRequest : \&quot;has\&quot;\n    ApplicationUser ||--o{ ReturnRequest : \&quot;requests\&quot;\n    ReturnRequest ||--|{ ReturnItem : \&quot;contains\&quot;\n    OrderItem ||--o{ ReturnItem : \&quot;returned as\&quot;\n    Product ||--o{ ProductReview : \&quot;reviewed in\&quot;\n    ApplicationUser ||--o{ ProductReview : \&quot;writes\&quot;\n    OrderItem |o--o{ ProductReview : \&quot;verifies\&quot;\n\n    %% Notifications\n    ApplicationUser ||--o{ Notification : \&quot;receives\&quot;\n    ApplicationUser ||--o{ NotificationPreference : \&quot;configures\&quot;\n    Notification ||--o{ NotificationDeliveryAttempt : \&quot;delivered by\&quot;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="rD2CrnjHf7nBMmlK65hn-507">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
