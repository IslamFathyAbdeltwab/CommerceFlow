{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=CommerceFlowDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "DeliveryDelaySeconds": 2
  },
  "Jwt": {
    "Issuer": "CommerceFlow",
    "Audience": "CommerceFlow.Client",
    "Key": "CommerceFlow-Development-Signing-Key-Change-Me-0123456789",
    "ExpirationMinutes": 60
  }
}
